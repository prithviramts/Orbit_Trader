# Orbit Trading Lab - copy to .env (which is git-ignored) and fill in locally.
# NEVER paste these values into chat, screenshots, issues or the browser.

# Alpaca PAPER trading keys (Alpaca dashboard -> switch to Paper account -> API keys)
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Must stay the paper endpoint. Any live URL makes Orbit refuse to start.
APCA_API_BASE_URL=https://paper-api.alpaca.markets
# iex = free feed. sip / delayed_sip need an entitlement you have verified.
ORBIT_DATA_FEED=iex

# Reference conversion used for AED display (not a bank rate)
USD_TO_AED=3.6725

# Local web server (loopback only by default)
ORBIT_BIND_HOST=127.0.0.1
ORBIT_PORT=8765
ORBIT_DEPLOYMENT_MODE=local
# ORBIT_PUBLIC_ORIGIN=https://orbit.example.internal   # remote mode only, behind HTTPS/VPN

# Optional phone notifications via ntfy (https://docs.ntfy.sh). Leave empty to use only the in-app inbox.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
